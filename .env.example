# Copy to .env for local development. .env is git-ignored.
# Placeholder values only — never put real credentials in this file.

# --- Phase 1 ---
SERVER_PORT=8080
SHIPSMART_LOG_LEVEL=DEBUG
# Set to json-logs for structured (ECS JSON) console logs
SPRING_PROFILES_ACTIVE=

# --- Phase 2 (MySQL) ---
# Defaults in application.yml match a local database created with the README
# instructions. Override them for any non-local environment.
DB_URL=jdbc:mysql://localhost:3306/shipsmart?connectionTimeZone=UTC
DB_USERNAME=shipsmart
# Local-only value; must match the password of your local MySQL user
DB_PASSWORD=shipsmart
DB_POOL_SIZE=10

# --- Phase 5 (Kafka) — not used yet ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
